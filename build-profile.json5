{
  "app": {
  // 签名配置不入库：在 DevEco Studio 中打开项目后，
  // File > Project Structure > Signing Configs 勾选 Automatically generate signature 即可自动生成调试签名。
  // 本机原有配置备份在 .workbuddy/backup/signing-configs.local.json5（该目录已在 .gitignore 中）
  "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
